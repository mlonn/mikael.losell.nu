{
  "$schema": "https://unpkg.com/wrangler@4.164.0/config-schema.json",
  "name": "mikael-losell-nu",
  "compatibility_date": "2026-11-18",
  // Static site served straight from the repo root; see .assetsignore for exclusions
  "assets": {
    "directory": ".",
    // Unknown paths get 404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // Enables `wrangler preview` (branch previews in Workers Builds)
  "previews": {}
}
